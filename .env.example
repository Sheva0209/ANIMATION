# Copy file ini menjadi .env dan isi dengan API keys kamu
# cp .env.example .env

# OpenAI — untuk GPT-4o script generation & Whisper (legacy)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs — belum aktif dipakai, opsional
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — untuk AI scene image generation (opsional)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace — cache ke drive D biar C: tidak penuh
HF_HOME=D:/hf_cache
TRANSFORMERS_CACHE=D:/hf_cache/transformers
HUGGINGFACE_HUB_CACHE=D:/hf_cache/hub

# Mirror HuggingFace untuk bypass ISP block (opsional)
HF_ENDPOINT=https://hf-mirror.com
